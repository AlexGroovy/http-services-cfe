
#Область СлужебныйПрограммныйИнтерфейс

// Выполняет поэтапную обработку запроса.
//
// Параметры:
//  Контекст - Структура
//
// Возвращаемое значение:
//  HTTPСервисОтвет
//
Функция ВыполнитьОбработку(Контекст) Экспорт
	
	Этапы = НовыйЭтапы();
	
	Для Каждого Этап Из Этапы Цикл
		ВыполнитьЭтап(Контекст, Этап);
	КонецЦикла;
	
	Возврат Контекст.HTTPСервисОтвет;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЭтапыВыполнения

// Этап выполняет автоматическую проверку запроса.
//
// Параметры:
//  Контекст - Структура
//
Процедура АвтоматическаяПроверкаЗапроса(Контекст) // BSLLS:UnusedLocalMethod-off
	
	Если ЕстьОшибки(Контекст) Тогда
		Возврат;
	КонецЕсли;
	
	HTTPСервисЗапросыСлужебный.ПроверитьЗапрос(
		Контекст.Схема, Контекст.Запрос, Контекст.ОшибкиКлиента);
	
КонецПроцедуры

// Этап выполняет автоматическую проверку ответа.
//
// Параметры:
//  Контекст - Структура
//
Процедура АвтоматическаяПроверкаОтвета(Контекст) // BSLLS:UnusedLocalMethod-off
	
	Если ЕстьОшибки(Контекст) Тогда
		Возврат;
	КонецЕсли;
	
	Ошибки = Новый Массив;
	HTTPСервисЗапросыСлужебный.ПроверитьОтвет(
		Контекст.Схема, Контекст.Ответ, Ошибки);
	
	Если Ошибки.Количество() > 0 Тогда
		ДобавитьОшибку(Контекст.ОшибкиСервера, ТекстВнутреннейОшибки());
	КонецЕсли;
	
КонецПроцедуры

// Этап инициализирует контекст.
//
// Параметры:
//  Контекст - Структура
//
Процедура Инициализация(Контекст) // BSLLS:UnusedLocalMethod-off
	
	НастройкиHTTPСервиса = Справочники.HTTPСервисы.НастройкиHTTPСервиса(Контекст.HTTPСервис);
	
	Если НастройкиHTTPСервиса = Неопределено Тогда
		ДобавитьОшибку(Контекст.ОшибкиСервера, ТекстВнутреннейОшибки());
		Возврат;
	КонецЕсли;
	
	Если НЕ НастройкиHTTPСервиса.Включен Тогда
		ДобавитьОшибку(Контекст.ОшибкиСервера, НСтр("ru = 'HTTP-сервис выключен.'"));
		Возврат;
	КонецЕсли;
	
	Схема = Справочники.СхемыHTTPСервисов.СхемаПоИдентификатору(
		НастройкиHTTPСервиса.Схема, НастройкиHTTPСервиса.Идентификатор);
	
	Если НЕ ЗначениеЗаполнено(Схема) Тогда
		ДобавитьОшибку(Контекст.ОшибкиСервера, ТекстВнутреннейОшибки());
		Возврат;
	КонецЕсли;
	
	Контекст.Включен = НастройкиHTTPСервиса.Включен;
	Контекст.Схема = Схема;
	Контекст.ОбработчикЗапроса = Обработки.ОбработчикHTTPСервисЗапроса.Создать();
	Контекст.ОбработчикЗапроса.Инициализировать(Контекст);
	Контекст.ОбработчикОтвета = Обработки.ОбработчикHTTPСервисОтвета.Создать();
	Контекст.ОбработчикОтвета.Инициализировать(Контекст);
	
	ЗаполнитьЗначенияСвойств(Контекст.Запрос, Контекст.HTTPСервисЗапрос);
	Контекст.Запрос.Агент = Контекст.ОбработчикЗапроса.Заголовок("User-Agent");
	Контекст.Запрос.ВнешнийИдентификатор = Контекст.ОбработчикЗапроса.Заголовок("X-Request-ID");
	Контекст.Запрос.Заголовки = Новый Соответствие(Контекст.HTTPСервисЗапрос.Заголовки);
	Контекст.Запрос.Метод = ВРег(Контекст.HTTPСервисЗапрос.HTTPМетод);
	Контекст.Запрос.ПараметрыURL = Новый Соответствие(Контекст.HTTPСервисЗапрос.ПараметрыURL);
	Контекст.Запрос.ПараметрыЗапроса = Новый Соответствие(Контекст.HTTPСервисЗапрос.ПараметрыЗапроса);
	Контекст.Запрос.ТелоКакДвоичныеДанные = Контекст.HTTPСервисЗапрос.ПолучитьТелоКакДвоичныеДанные();
	Контекст.Запрос.ТелоКакСтрока = Контекст.HTTPСервисЗапрос.ПолучитьТелоКакСтроку();
	Контекст.Запрос.ТипКонтента = ОпределитьТипКонтента(Контекст.Схема.ТелоЗапроса, Контекст.HTTPСервисЗапрос.Заголовки);
	
	Если СхемыHTTPСервисовПовтИсп.ЭтоТипКонтентаJSON(Контекст.Запрос.ТипКонтента) Тогда
		Попытка
			Контекст.Запрос.ТелоКакОбъект = СериализацияДанных.ПрочитатьДанныеJSON(Контекст.Запрос.ТелоКакСтрока);
		Исключение
			ОписаниеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("ОбработчикHTTPСервисЗапроса.Инициализация",
				УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки);
			ОписаниеОшибки = НСтр("ru = 'Не удалось сериализовать тело запроса из JSON.'");
			ДобавитьОшибку(Контекст.ОшибкиКлиента, ОписаниеОшибки);
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Этап выполняет запуск обработчиков запроса.
//
// Параметры:
//  Контекст - Структура
//
Процедура ОбработкаЗапроса(Контекст) // BSLLS:UnusedLocalMethod-off
	
	Если ЕстьОшибки(Контекст) Тогда
		Возврат;
	КонецЕсли;
	
	Обработчики = HTTPСервисЗапросыСлужебный.ОбработчикиЗапросов();
	Обработчик = НайтиОбработчик(Контекст, Обработчики);
	
	Если Обработчик = Неопределено Тогда
		ОписаниеОшибки = НСтр("ru = 'Не найден обработчик запроса.'");
		ЗаписьЖурналаРегистрации("ОбработчикHTTPСервисЗапроса.ОбработкаЗапроса",
			УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки);
		ДобавитьОшибку(Контекст.ОшибкиСервера, ТекстВнутреннейОшибки());
		Возврат;
	КонецЕсли;
	
	Попытка
		ВыполнитьОбработчик(Контекст, Обработчик);
	Исключение
		ОписаниеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("ОбработчикHTTPСервисЗапроса.ОбработкаЗапроса",
			УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки);
		ДобавитьОшибку(Контекст.ОшибкиСервера, ТекстВнутреннейОшибки());
	КонецПопытки;
	
КонецПроцедуры

