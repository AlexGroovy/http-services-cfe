// Этап фиксирует входящий запрос в логе HTTP запросов.
//
// Параметры:
//  Контекст - Структура
//
Процедура РегистрацияЗапроса(Контекст) // BSLLS:UnusedLocalMethod-off
	
	ОбеспечитьИдентификаторЗапроса(Контекст);
	
	Обработчики = HTTPСервисЗапросыСлужебный.ОбработчикиРегистрацииЗапроса();
	Обработчик = НайтиОбработчик(Контекст, Обработчики);
	
	Если Обработчик = Неопределено Тогда
		РегистрыСведений.ЛогHTTPЗапросов.ЗафиксироватьЗапрос(Контекст);
		Возврат;
	КонецЕсли;
	
	Попытка
		ВыполнитьОбработчик(Контекст, Обработчик);
	Исключение
		ОписаниеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("ОбработчикHTTPСервисЗапроса.РегистрацияЗапроса",
			УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки);
	КонецПопытки;
	
КонецПроцедуры

