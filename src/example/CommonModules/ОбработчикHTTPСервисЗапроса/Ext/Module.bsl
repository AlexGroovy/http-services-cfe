		РегистрыСведений.ЛогHTTPЗапросов.ЗафиксироватьОтвет(Контекст);
		Возврат;
	КонецЕсли;
	
	Попытка
		ВыполнитьОбработчик(Контекст, Обработчик);
	Исключение
		ОписаниеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
