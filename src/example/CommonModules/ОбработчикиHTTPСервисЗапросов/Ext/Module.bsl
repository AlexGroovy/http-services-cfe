Процедура ПриДобавленииОбработчиковЗапросов(Обработчики) Экспорт
	
	Обработчик = Обработчики.Добавить();
	Обработчик.HTTPСервис = Справочники.HTTPСервисы.Echo;
	Обработчик.Обработчик = "ОбработчикиHTTPСервисЗапросов.ОбработатьЗапросEcho"; 
	
	Обработчик = Обработчики.Добавить();
	Обработчик.HTTPСервис = Справочники.HTTPСервисы.GetContragents;
	Обработчик.Обработчик = "ОбработчикиHTTPСервисЗапросов.ОбработатьЗапросGetContragents";
	Обработчик.ВПривилегированномРежиме = Истина;
	
	Обработчик = Обработчики.Добавить();
	Обработчик.HTTPСервис = Справочники.HTTPСервисы.CreateContragent;
	Обработчик.Обработчик = "ОбработчикиHTTPСервисЗапросов.ОбработатьЗапросCreateContragent";
	Обработчик.ВПривилегированномРежиме = Истина;

	Обработчик = Обработчики.Добавить();
	Обработчик.HTTPСервис = Справочники.HTTPСервисы.GetContracts;
	Обработчик.Обработчик = "ОбработчикиHTTPСервисЗапросов.ОбработатьЗапросGetContracts";
	Обработчик.ВПривилегированномРежиме = Истина;
	
КонецПроцедуры

