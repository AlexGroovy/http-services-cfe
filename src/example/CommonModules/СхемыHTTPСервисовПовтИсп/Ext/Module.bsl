// Возвращает тип данных в формате 1С.
//
// Параметры:
//  ТипДанных - Строка - Тип данных в формате OpenAPI
//
// Возвращаемое значение:
//  Строка - Тип данных в формате 1С
//
Функция ТипДанных(ТипДанных) Экспорт
	
	Если ЭтоТипДанныхБулево(ТипДанных) Тогда
		Результат = "Булево";
	ИначеЕсли ЭтоТипДанныхМассив(ТипДанных) Тогда
		Результат = "Массив";
	ИначеЕсли ЭтоТипДанныхОбъект(ТипДанных) Тогда
		Результат = "Объект";
	ИначеЕсли ЭтоТипДанныхСтрока(ТипДанных) Тогда
		Возврат "Строка";
	ИначеЕсли ЭтоТипДанныхЧисло(ТипДанных) Тогда
		Возврат "Число";
	Иначе
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Это тип данных Булево (boolean).
//
// Параметры:
