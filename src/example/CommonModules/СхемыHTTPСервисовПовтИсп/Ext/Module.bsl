#Область ТипыКонтента

// Возвращает тип контента в формате 1С.
//
// Параметры:
//  Тип - Строка - Тип контента в формате MIME
//
// Возвращаемое значение:
//  Строка - Тип контента в формате 1С
//
Функция ТипКонтента(Тип) Экспорт
	
	ТипыКонтента = ТипыКонтента();
	ТипНРег = НРег(Тип);
	
	Если ТипНРег = "" Тогда
		Результат = ТипыКонтента.НетКонтента;
	ИначеЕсли СтрНайти(ТипНРег, ТипыКонтента.JSON) > 0 Тогда
		Результат = ТипыКонтента.JSON;
	ИначеЕсли СтрНайти(ТипНРег, ТипыКонтента.Строка) > 0 Тогда
		Результат = ТипыКонтента.Строка;
	ИначеЕсли СтрНайти(ТипНРег, ТипыКонтента.ДвоичныеДанные) > 0 Тогда
		Результат = ТипыКонтента.ДвоичныеДанные;
	ИначеЕсли СтрНайти(ТипНРег, ТипыКонтента.PDF) > 0 Тогда
		Результат = ТипыКонтента.PDF;
	ИначеЕсли СтрНайти(ТипНРег, ТипыКонтента.DOC) > 0 Тогда
		Результат = ТипыКонтента.DOC;
	ИначеЕсли СтрНайти(ТипНРег, ТипыКонтента.XLS) > 0 Тогда
		Результат = ТипыКонтента.XLS;
	ИначеЕсли СтрНайти(ТипНРег, ТипыКонтента.PPT) > 0 Тогда
		Результат = ТипыКонтента.PPT;
	ИначеЕсли СтрНайти(ТипНРег, ТипыКонтента.DOCX) > 0 Тогда
		Результат = ТипыКонтента.DOCX;
	ИначеЕсли СтрНайти(ТипНРег, ТипыКонтента.XLSX) > 0 Тогда
		Результат = ТипыКонтента.XLSX;
	ИначеЕсли СтрНайти(ТипНРег, ТипыКонтента.PPTX) > 0 Тогда
		Результат = ТипыКонтента.PPTX;
	ИначеЕсли СтрНайти(ТипНРег, ТипыКонтента.BMP) > 0 Тогда
		Результат = ТипыКонтента.BMP;
	ИначеЕсли СтрНайти(ТипНРег, ТипыКонтента.GIF) > 0 Тогда
		Результат = ТипыКонтента.GIF;
	ИначеЕсли СтрНайти(ТипНРег, ТипыКонтента.HEIC) > 0 Тогда
		Результат = ТипыКонтента.HEIC;
	ИначеЕсли СтрНайти(ТипНРег, ТипыКонтента.JPEG) > 0 Тогда
		Результат = ТипыКонтента.JPEG;
	ИначеЕсли СтрНайти(ТипНРег, ТипыКонтента.PNG) > 0 Тогда
		Результат = ТипыКонтента.PNG;
	ИначеЕсли СтрНайти(ТипНРег, ТипыКонтента.SWG) > 0 Тогда
		Результат = ТипыКонтента.SWG;
	ИначеЕсли СтрНайти(ТипНРег, ТипыКонтента.WEBP) > 0 Тогда
		Результат = ТипыКонтента.WEBP;
	ИначеЕсли СтрНайти(ТипНРег, ТипыКонтента.HTML) > 0 Тогда
		Результат = ТипыКонтента.HTML;
	Иначе
		Результат = ТипыКонтента.Неизвестный;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает доступные типы контента.
//
// Возвращаемое значение:
//  Структура - Типы контента
//    * Ключ - Строка - Тип контента в формате 1С
//    * Значение - Строка - Тип контента в формате MIME
//
Функция ТипыКонтента() Экспорт
	
	ТипыКонтента = Новый Структура;
	ТипыКонтента.Вставить("BMP", "image/bmp");
	ТипыКонтента.Вставить("DOC", "application/msword");
	ТипыКонтента.Вставить("DOCX", "application/vnd.openxmlformats-officedocument.wordprocessingml.document");
	ТипыКонтента.Вставить("GIF", "image/gif");
	ТипыКонтента.Вставить("HEIC", "image/heic");
	ТипыКонтента.Вставить("HTML", "text/html");
	ТипыКонтента.Вставить("JPEG", "image/jpeg");
	ТипыКонтента.Вставить("JSON", "application/json");
	ТипыКонтента.Вставить("PDF", "application/pdf");
	ТипыКонтента.Вставить("PNG", "image/png");
	ТипыКонтента.Вставить("PPT", "application/vnd.ms-powerpoint");
	ТипыКонтента.Вставить("PPTX", "application/vnd.openxmlformats-officedocument.presentationml.presentation");
	ТипыКонтента.Вставить("SWG", "image/svg+xml");
	ТипыКонтента.Вставить("WEBP", "image/webp");
	ТипыКонтента.Вставить("XLS", "application/vnd.ms-excel");
	ТипыКонтента.Вставить("XLSX", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
	ТипыКонтента.Вставить("ДвоичныеДанные", "application/octet-stream");
	ТипыКонтента.Вставить("Неизвестный", "unknown content type");
	ТипыКонтента.Вставить("НетКонтента", "no content");
	ТипыКонтента.Вставить("Строка", "text/plain");
	Возврат ТипыКонтента;
	
КонецФункции

// Это тип контента JSON.
//
// Параметры:
//  ТипКонтента - Строка - Тип контента в формате MIME
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоТипКонтентаJSON(ТипКонтента) Экспорт
	
	Возврат ТипКонтента = ТипыКонтента().JSON;
	
КонецФункции

// Это тип контента ДвоичныеДанные.
//
// Параметры:
//  ТипКонтента - Строка - Тип контента в формате MIME
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоТипКонтентаДвоичныеДанные(ТипКонтента) Экспорт
	
	ТипыКонтента = ТипыКонтента();
	Возврат ТипКонтента = ТипыКонтента.ДвоичныеДанные
		ИЛИ ТипКонтента = ТипыКонтента.PDF
		ИЛИ ТипКонтента = ТипыКонтента.DOC
		ИЛИ ТипКонтента = ТипыКонтента.XLS
		ИЛИ ТипКонтента = ТипыКонтента.PPT
		ИЛИ ТипКонтента = ТипыКонтента.DOCX
		ИЛИ ТипКонтента = ТипыКонтента.XLSX
		ИЛИ ТипКонтента = ТипыКонтента.PPTX
		ИЛИ ТипКонтента = ТипыКонтента.BMP
		ИЛИ ТипКонтента = ТипыКонтента.GIF
		ИЛИ ТипКонтента = ТипыКонтента.HEIC
		ИЛИ ТипКонтента = ТипыКонтента.JPEG
		ИЛИ ТипКонтента = ТипыКонтента.PNG
		ИЛИ ТипКонтента = ТипыКонтента.SWG
		ИЛИ ТипКонтента = ТипыКонтента.WEBP;
	
КонецФункции

// Это тип контента НетКонтента.
//
// Параметры:
//  ТипКонтента - Строка - Тип контента в формате MIME
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоТипКонтентаНетКонтента(ТипКонтента) Экспорт
	
