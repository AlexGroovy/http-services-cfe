#Область ФорматыДанных

// Возвращает формат данных в формате 1С.
//
// Параметры:
//  ФорматДанных - Строка - Формат данных в формате OpenAPI
//
// Возвращаемое значение:
//  Строка - Формат данных в формате 1С
//
Функция ФорматДанных(ФорматДанных) Экспорт
	
	Если ЭтоФорматДанныхАдресЭлектроннойПочты(ФорматДанных) Тогда
		Результат = "АдресЭлектроннойПочты";
	ИначеЕсли ЭтоФорматДанныхБайты(ФорматДанных) Тогда
		Результат = "Байты";
	ИначеЕсли ЭтоФорматДанныхБольшоеДробноеЧисло(ФорматДанных) Тогда
		Результат = "БольшоеДробноеЧисло";
	ИначеЕсли ЭтоФорматДанныхБольшоеЦелоеЧисло(ФорматДанных) Тогда
		Результат = "БольшоеЦелоеЧисло";
	ИначеЕсли ЭтоФорматДанныхДата(ФорматДанных) Тогда
		Результат = "Дата";
	ИначеЕсли ЭтоФорматДанныхДатаВремя(ФорматДанных) Тогда
		Результат = "ДатаВремя";
	ИначеЕсли ЭтоФорматДанныхДвоичныеДанные(ФорматДанных) Тогда
		Результат = "ДвоичныеДанные";
	ИначеЕсли ЭтоФорматДанныхДробноеЧисло(ФорматДанных) Тогда
		Результат = "ДробноеЧисло";
	ИначеЕсли ЭтоФорматДанныхПароль(ФорматДанных) Тогда
		Результат = "Пароль"; // BSLLS:UsingHardcodeSecretInformation-off
	ИначеЕсли ЭтоФорматДанныхТокен(ФорматДанных) Тогда
		Результат = "Токен"; // BSLLS:UsingHardcodeSecretInformation-off
	ИначеЕсли ЭтоФорматДанныхУникальныйИдентификатор(ФорматДанных) Тогда
		Результат = "УникальныйИдентификатор";
	ИначеЕсли ЭтоФорматДанныхЦелоеЧисло(ФорматДанных) Тогда
		Результат = "ЦелоеЧисло";
	Иначе
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

