	КонецЕсли;
	
	Для Каждого ЭлементКоллекции Из Схема.Ответы Цикл
		ЗаполнитьЗначенияСвойств(Ответы.Добавить(), ЭлементКоллекции);
	КонецЦикла;
	
	Ответы.Сортировать("КодСостояния,Тип");
	
КонецПроцедуры

