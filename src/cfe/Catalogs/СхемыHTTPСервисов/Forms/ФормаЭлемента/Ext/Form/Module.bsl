КонецФункции

// Заполняет HTTP-сервисы на форме.
//
&НаКлиенте
Процедура ЗаполнитьHTTPСервисы()
	
	Если Схема1С = Неопределено ИЛИ Схема1С.Схема = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементКоллекции Из Схема1С.Схема Цикл
		ЗаполнитьЗначенияСвойств(HTTPСервисы.Добавить(), ЭлементКоллекции.Значение);
	КонецЦикла;
	
	HTTPСервисы.Сортировать("Идентификатор");
	
КонецПроцедуры

// Заполняет контент ответа на форме.
//
// Параметры:
//  Идентификатор - Строка
//  КодСостояния - Число
//  Тип - Строка
//
&НаКлиенте
Процедура ЗаполнитьЗаголовкиОтвета(Идентификатор, КодСостояния, Тип)
	
	Схема = СхемаПоИдентификатору(Идентификатор);
	
	Если Схема = Неопределено ИЛИ Схема.Ответы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементКоллекции Из Схема.Ответы Цикл
		Если ЭлементКоллекции.Тип = Тип
				И КодСостояния = ЭлементКоллекции.КодСостояния
				И ЭлементКоллекции.Заголовки <> Неопределено Тогда
			Для Каждого ВложенныйЭлементКоллекции Из ЭлементКоллекции.Заголовки Цикл
				ЗаполнитьЗначенияСвойств(ЗаголовкиОтвета.Добавить(), ВложенныйЭлементКоллекции);
			КонецЦикла;
			
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ЗаголовкиОтвета.Сортировать("Имя");
	
КонецПроцедуры

// Заполняет контент ответа на форме.
//
// Параметры:
//  Идентификатор - Строка
//  КодСостояния - Число
//  Тип - Строка
//
&НаКлиенте
Процедура ЗаполнитьКонтентОтвета(Идентификатор, КодСостояния, Тип)
	
	Схема = СхемаПоИдентификатору(Идентификатор);
	
	Для Каждого ЭлементКоллекции Из Схема.Ответы Цикл
		Если ЭлементКоллекции.Тип = Тип
				И КодСостояния = ЭлементКоллекции.КодСостояния
				И ЭлементКоллекции.Контент <> Неопределено Тогда
			Контент = ЗаписатьДанныеJSON(ЭлементКоллекции.Контент);
			КонтентОтвета = ПредставлениеДереваJSON(Контент, Истина);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Заполняет контент тела запроса на форме.
//
// Параметры:
//  Идентификатор - Строка
//  Тип - Строка
//
&НаКлиенте
Процедура ЗаполнитьКонтентТелаЗапроса(Идентификатор, Тип)
	
	Схема = СхемаПоИдентификатору(Идентификатор);
	
	Если Схема = Неопределено ИЛИ Схема.ТелоЗапроса = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементКоллекции Из Схема.ТелоЗапроса Цикл
		Если ЭлементКоллекции.Тип = Тип Тогда
			Контент = ЗаписатьДанныеJSON(ЭлементКоллекции.Контент);
			КонтентТелаЗапроса = ПредставлениеДереваJSON(Контент, Истина);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Заполняет ответы на форме.
//
// Параметры:
//  Идентификатор - Строка
//
&НаКлиенте
Процедура ЗаполнитьОтветы(Идентификатор)
	
	Схема = СхемаПоИдентификатору(Идентификатор);
	
	Если Схема = Неопределено ИЛИ Схема.Ответы = Неопределено Тогда
