// Возвращает представление дерева JSON в формате HTML.
//
// Параметры:
//  Данные - Строка
//  ЗаменитьПредставление - Булево
//
// Возвращаемое значение:
//  Строка
//
&НаСервереБезКонтекста
Функция ПредставлениеДереваJSON(Знач Данные, Знач ЗаменитьПредставление)
	
	Макет = ПолучитьОбщийМакет("ПредставлениеДереваJSON").ПолучитьТекст();
	Макет = СтрЗаменить(Макет, "%json%", ЭкранироватьСимволыJSON(Данные));
	Возврат СтрЗаменить(Макет, "%replace%", ?(ЗаменитьПредставление, "true", "false"));
	
КонецФункции

// см. СхемыHTTPСервисов.ПрочитатьСхемуJSON
//
&НаСервереБезКонтекста
Функция ПрочитатьСхемуJSON(Знач СхемаJSON)
	
	Возврат СхемыHTTPСервисов.ПрочитатьСхемуJSON(СхемаJSON);
	
КонецФункции

// Возвращает схема по идентификатору.
//
// Параметры:
//  Идентификатор - Строка
//
// Возвращаемое значение:
//  - Структура
//  - Неопределено
//
&НаКлиенте
Функция СхемаПоИдентификатору(Идентификатор)
	
	Если ТипЗнч(Схема1С.Схема) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Схема1С.Схема.Получить(Идентификатор);
	
КонецФункции

// Экранирует специальные символы в JSON.
//
// Параметры:
//  СтрокаJSON - Строка
//
// Возвращаемое значение:
//  Строка
//
&НаСервереБезКонтекста
Функция ЭкранироватьСимволыJSON(Знач СтрокаJSON)
	
	НоваяСтрокаJSON = СтрЗаменить(СтрокаJSON, "\", "\\");
	НоваяСтрокаJSON = СтрЗаменить(НоваяСтрокаJSON, Символы.ПС, "");
	НоваяСтрокаJSON = СтрЗаменить(НоваяСтрокаJSON, Символы.ВК, "");
	НоваяСтрокаJSON = СтрЗаменить(НоваяСтрокаJSON, "'", "\'");
	Возврат СтрЗаменить(НоваяСтрокаJSON, """", "\""");
	
КонецФункции

// Возвращает пустой HTML.
//
// Возвращаемое значение:
//  Строка
//
&НаКлиенте
Функция ПустойHTML()
	
	Возврат "<html><head></head><body></body></html>";
	
КонецФункции

#КонецОбласти
