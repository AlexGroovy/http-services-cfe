
#Область ОбработчикиСобытийФормы

// Обработчик события формы "ПриЧтенииНаСервере".
//
// Параметры:
//  ТекущийОбъект - СправочникОбъект.HTTPСервисы
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Схема1С = НовыйСхема1С(ТекущийОбъект.Схема1С.Получить());
	
КонецПроцедуры

// Обработчик события формы "ПриОткрытии".
//
// Параметры:
//  Отказ - Булево
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗаполнитьHTTPСервисы();
	ЗаполнитьСхемуJSON();
	
КонецПроцедуры

// Обработчик события формы "ПередЗаписьюНаСервере".
//
// Параметры:
//  Отказ - Булево
//  ТекущийОбъект - СправочникОбъект.HTTPСервисы
//  ПараметрыЗаписи - Структура
//
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Схема = Коллекции.ЗначениеСвойстваСтруктуры(Схема1С, "Схема");
	ТекущийОбъект.Схема1С = Новый ХранилищеЗначения(Схема, Новый СжатиеДанных(9));
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыHTTPСервисы

// Обработчик события "ПриАктивизацииСтроки" таблицы "HTTPСервисы".
//
// Параметры:
//  Элемент - ПолеФормы
//
&НаКлиенте
Процедура HTTPСервисыПриАктивизацииСтроки(Элемент)
	
	ОчиститьПараметры();
	ОчиститьТелоЗапроса();
	ОчиститьОтветы();
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Идентификатор = Элемент.ТекущиеДанные.Идентификатор;
	ЗаполнитьПараметрыURL(Идентификатор);
	ЗаполнитьПараметрыЗаголовков(Идентификатор);
	ЗаполнитьПараметрыЗапроса(Идентификатор);
	ЗаполнитьПараметрыКуки(Идентификатор);
	ЗаполнитьТелоЗапроса(Идентификатор);
	ЗаполнитьОтветы(Идентификатор);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОтветы

// Обработчик события "ПриАктивизацииСтроки" таблицы "Ответы".
//
// Параметры:
//  Элемент - ПолеФормы
//
&НаКлиенте
Процедура ОтветыПриАктивизацииСтроки(Элемент)
	
	ОчиститьКонтентОтвета();
	ОчиститьЗаголовкиОтвета();
	
	Если Элементы.HTTPСервисы.ТекущиеДанные = Неопределено
			ИЛИ Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Идентификатор = Элементы.HTTPСервисы.ТекущиеДанные.Идентификатор;
	Тип = Элемент.ТекущиеДанные.Тип;
	КодСостояния = Элемент.ТекущиеДанные.КодСостояния;
	ЗаполнитьЗаголовкиОтвета(Идентификатор, КодСостояния, Тип);
	ЗаполнитьКонтентОтвета(Идентификатор, КодСостояния, Тип);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТелоЗапроса

// Обработчик события "ПриАктивизацииСтроки" таблицы "ТелоЗапроса".
//
// Параметры:
//  Элемент - ПолеФормы
//
&НаКлиенте
Процедура ТелоЗапросаПриАктивизацииСтроки(Элемент)
	
	ОчиститьКонтентТелаЗапроса();
	
	Если Элементы.HTTPСервисы.ТекущиеДанные = Неопределено
			ИЛИ Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Идентификатор = Элементы.HTTPСервисы.ТекущиеДанные.Идентификатор;
	Тип = Элемент.ТекущиеДанные.Тип;
	ЗаполнитьКонтентТелаЗапроса(Идентификатор, Тип);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Обработчик команды "ЗагрузитьСхему".
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Асинх Процедура ЗагрузитьСхему(Команда)
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.Фильтр = НСтр("ru = 'Схема OpenAPI (*.json)|*.json'");
	ДиалогВыбораФайла.Заголовок = НСтр("ru = 'Выберите файл'");
	ДиалогВыбораФайла.МножественныйВыбор = Ложь;
	ДиалогВыбораФайла.ИндексФильтра = 0;
	
	ВыбранныеФайлы = Ждать ДиалогВыбораФайла.ВыбратьАсинх();
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЧтениеТекста = Новый ЧтениеТекста(ДиалогВыбораФайла.ПолноеИмяФайла, КодировкаТекста.UTF8);
	Объект.СхемаJSON = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	
	Схема1С = НовыйСхема1С(ПрочитатьСхемуJSON(Объект.СхемаJSON));
	
	ОчиститьHTTPСервисы();
	ЗаполнитьHTTPСервисы();
	ЗаполнитьСхемуJSON();
	
КонецПроцедуры

// Обработчик команды "СохранитьСхему".
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Асинх Процедура СохранитьСхему(Команда)
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогВыбораФайла.Фильтр = НСтр("ru = 'Схема OpenAPI (*.json)|*.json'");
	ДиалогВыбораФайла.Заголовок = НСтр("ru = 'Выберите файл'");
	ДиалогВыбораФайла.МножественныйВыбор = Ложь;
	ДиалогВыбораФайла.ИндексФильтра = 0;
	
	ВыбранныеФайлы = Ждать ДиалогВыбораФайла.ВыбратьАсинх();
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписьТекста = Новый ЗаписьТекста(ДиалогВыбораФайла.ПолноеИмяФайла, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(Объект.СхемаJSON);
	ЗаписьТекста.Закрыть();
	
КонецПроцедуры

#КонецОбласти

