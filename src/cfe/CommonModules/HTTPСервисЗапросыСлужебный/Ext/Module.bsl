// Добавляет ошибку в коллекцию ошибок.
//
// Параметры:
//  Ошибки - Массив из Строка
//  Контекст - Строка
//  Текст - Строка
//
Процедура ДобавитьОшибку(Ошибки, Контекст, Текст)
	
	Ошибки.Добавить(СтрШаблон("%1 | %2", Контекст, Текст));
	
КонецПроцедуры

// Проверяет наличие свойства по ключу.
//
// Параметры:
//  Коллекция - Структура, Соответствие
//  Свойство - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьСвойство(Коллекция, Свойство)
	
	Возврат Коллекции.ЕстьСвойствоКоллекцииКлючЗначение(Коллекция, Свойство);
	
КонецФункции

// Возвращает значение свойства по ключу.
// Если ключ не найден, возвращает значение по умолчанию.
//
// Параметры:
//  Коллекция - Структура, Соответствие
//  Свойство - Строка
//  ЗначениеПоУмолчанию - Произвольный
//
// Возвращаемое значение:
//  Произвольный
//
Функция ЗначениеСвойства(Коллекция, Свойство, ЗначениеПоУмолчанию = Неопределено)
	
	Возврат Коллекции.ЗначениеСвойстваКоллекцииКлючЗначение(
		Коллекция, Свойство, ЗначениеПоУмолчанию);
	
КонецФункции

// Преобразовывает строку к типу.
//
// Параметры:
//  Тип - Строка
//  Значение - Строка
//
// Возвращаемое значение:
//  Произвольный
//
Функция ПривестиСтрокуКТипу(Тип, Значение)
	
	Если СхемыHTTPСервисовПовтИсп.ЭтоТипДанныхЧисло(Тип) Тогда
		НовоеЗначение = СтрокаВЧисло(Значение);
	ИначеЕсли СхемыHTTPСервисовПовтИсп.ЭтоТипДанныхБулево(Тип) Тогда
		НовоеЗначение = СтрокаВБулево(Значение);
	Иначе
		НовоеЗначение = Значение;
	КонецЕсли;
	
	Возврат НовоеЗначение;
	
КонецФункции

// Проверяет строку на соответствие паттерну.
//
// Параметры:
//  Значение - Строка
//  Паттерн - Строка
//  ИгнорироватьРегистр - Булево
//
// Возвращаемое значение:
//  Булево
//
Функция СоответствуетПаттерну(Значение, Паттерн, ИгнорироватьРегистр = Истина)
	
	Попытка
		СоответствуетПаттерну = СтрПодобнаПоРегулярномуВыражению(Значение, Паттерн, ИгнорироватьРегистр, Ложь);
	Исключение
		СоответствуетПаттерну = Ложь;
	КонецПопытки;
	
	Возврат СоответствуетПаттерну;
	
КонецФункции

// Преобразовывает строку в булево.
//
// Параметры:
//  Значение - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция СтрокаВБулево(Значение)
	
	СоответствиеЗначений = Новый Соответствие;
	СоответствиеЗначений.Вставить("true", Истина);
	СоответствиеЗначений.Вставить("false", Ложь);
	СоответствиеЗначений.Вставить("истина", Истина);
	СоответствиеЗначений.Вставить("ложь", Ложь);
	НовоеЗначение = СоответствиеЗначений.Получить(НРег(Значение));
	Возврат ?(НовоеЗначение = Неопределено, Значение, НовоеЗначение);
	
КонецФункции

// Преобразовывает строку в число.
//
// Параметры:
//  Значение - Строка
//
// Возвращаемое значение:
//  Число
//
Функция СтрокаВЧисло(Значение)
	
	Значение  = СтрЗаменить(Значение, " ", "");
	
	Если СтрНачинаетсяС(Значение, "(") Тогда
		Значение = СтрЗаменить(Значение, "(", "-");
		Значение = СтрЗаменить(Значение, ")", "");
	КонецЕсли;
	
	СтрокаБезНулей = СтрЗаменить(Значение, "0", "");
	
	Если ПустаяСтрока(СтрокаБезНулей) Или СтрокаБезНулей = "-" Тогда
		Возврат 0;
	КонецЕсли;
	
	ТипЧисло  = Новый ОписаниеТипов("Число");
	Результат = ТипЧисло.ПривестиЗначение(Значение);
	НовоеЗначение = ?(Результат <> 0 И Не ПустаяСтрока(СтрокаБезНулей), Результат, Неопределено);
	Возврат ?(НовоеЗначение = Неопределено, Значение, НовоеЗначение);
	
КонецФункции

// Возвращает тело по типу контента.
//
// Параметры:
//  Источник - Структура
//
// Возвращаемое значение:
//  - Структура, Соответствие, Массив
//  - Строка
//  - ДвоичныеДанные
//  - Неопределено
//
Функция ТелоПоТипуКонтента(Источник)
	
	Если СхемыHTTPСервисовПовтИсп.ЭтоТипКонтентаJSON(Источник.ТипКонтента) Тогда
		Результат = Источник.ТелоКакОбъект;
	ИначеЕсли СхемыHTTPСервисовПовтИсп.ЭтоТипКонтентаСтрока(Источник.ТипКонтента) Тогда
		Результат = Источник.ТелоКакСтрока;
	ИначеЕсли СхемыHTTPСервисовПовтИсп.ЭтоТипКонтентаДвоичныеДанные(Источник.ТипКонтента) Тогда
		Результат = Источник.ТелоКакДвоичныеДанные;
	ИначеЕсли СхемыHTTPСервисовПовтИсп.ЭтоТипКонтентаНетКонтента(Источник.ТипКонтента) Тогда
		Результат = "";
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
