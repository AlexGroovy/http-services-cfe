//  Структура
//
Функция ПрочитатьДоступноеЗначение(Схема, Компоненты)
	
	Возврат ПрочитатьДанныеРекурсивно(Схема, Компоненты);
	
КонецФункции

// Читает описание заголовка ответа.
//
// Параметры:
//  Схема - Соответствие
//  Компоненты - Соответствие, Неопределено
//  Имя - Строка
//
// Возвращаемое значение:
//  Структура
//
Функция ПрочитатьЗаголовокОтвета(Схема, Компоненты, Имя)
	
	Обязательный = ЗначениеСвойстваСхемы(Схема, Компоненты, "required", Ложь);
	Устарел = ЗначениеСвойстваСхемы(Схема, Компоненты, "deprecated", Ложь);
	ВложеннаяСхема = ЗначениеСвойстваСхемы(Схема, Компоненты, "schema");
	
	Заголовок = ПрочитатьДанныеРекурсивно(ВложеннаяСхема, Компоненты);
	Заголовок.Вставить("Имя", Имя);
	Заголовок.Вставить("Обязательный", Обязательный);
	Заголовок.Вставить("Устарел", Устарел);
	
	Варианты = Коллекции.ЗначениеСвойстваСтруктуры(Заголовок, "Варианты");
	
	Если Варианты <> Неопределено Тогда
		Для Каждого Вариант Из Варианты Цикл
			Вариант.Вставить("Обязательный", Обязательный);
			Вариант.Вставить("Устарел", Устарел);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Заголовок;
	
КонецФункции

// Читает описание контента тела запроса.
//
// Параметры:
//  Схема - Соответствие
//  Компоненты - Соответствие, Неопределено
//
// Возвращаемое значение:
//  Структура
//
Функция ПрочитатьКонтентТелаЗапроса(Схема, Компоненты)
	
