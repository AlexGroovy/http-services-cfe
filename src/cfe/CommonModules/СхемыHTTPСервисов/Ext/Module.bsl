
#Область СлужебныйПрограммныйИнтерфейс

// Читает схему OpenAPI в формате JSON и сериализует ее в формат 1С.
// В случае ошибки выбрасывает исключение.
//
// Параметры:
//  СхемаJSON - Строка
//
// Возвращаемое значение:
//  Соответствие
//
Функция ПрочитатьСхемуJSON(СхемаJSON) Экспорт
	
	Схема = ПрочитатьДанныеJSON(СхемаJSON);
	Возврат СериализоватьСхемуOpenAPI(Схема);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеСхемы

// Заполняет схему HTTP-сервиса.
//
// Параметры:
//  ВерсияСтандарта - Строка
//  Схема - Соответствие
//  Компоненты - Соответствие, Неопределено
//  HTTPСервис - Структура
//  Метод - Строка
//  ШаблонURL - Строка
//
Процедура ЗаполнитьHTTPСервис(ВерсияСтандарта, Схема, Компоненты, HTTPСервис, Метод, ШаблонURL)
	
	HTTPСервис.ВерсияСтандарта = ВерсияСтандарта;
	HTTPСервис.ШаблонURL = ШаблонURL;
	HTTPСервис.Идентификатор = ЗначениеСвойстваСхемы(Схема, Неопределено, "operationId", "");
	HTTPСервис.Метод = ВРег(Метод);
	HTTPСервис.Устарел = ЗначениеСвойстваСхемы(Схема, Неопределено, "deprecated", Ложь);
	
	Ответы = ЗначениеСвойстваСхемы(Схема, Неопределено, "responses");
	ЗаполнитьОтветы(Ответы, Компоненты, HTTPСервис);
	
	Параметры = ЗначениеСвойстваСхемы(Схема, Неопределено, "parameters");
	ЗаполнитьПараметры(Параметры, Компоненты, HTTPСервис);
	
	ТелоЗапроса = ЗначениеСвойстваСхемы(Схема, Компоненты, "requestBody");
	ЗаполнитьТелоЗапроса(ТелоЗапроса, Компоненты, HTTPСервис);
	
КонецПроцедуры

// Заполняет доступные значения у произвольного объекта.
//
// Параметры:
//  Схемы - Массив из Соответствие, Неопределено
//  Компоненты - Структура, Неопределено
//  Владелец - Структура
//
Процедура ЗаполнитьДоступныеЗначения(Схемы, Компоненты, Владелец)
	
	Если Схемы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Схема Из Схемы Цикл
		Если Коллекции.ЭтоСоответствие(Схема) Тогда
			ДоступноеЗначение = ПрочитатьДоступноеЗначение(Схема, Компоненты);
		Иначе
			ДоступноеЗначение = Схема;
		КонецЕсли;
		
		Если Владелец.ДоступныеЗначения = Неопределено Тогда
			Владелец.ДоступныеЗначения = Новый Массив;
		КонецЕсли;
		
		Владелец.ДоступныеЗначения.Добавить(ДоступноеЗначение);
	КонецЦикла;
	
КонецПроцедуры

// Заполняет схему заголовков ответа.
//
// Параметры:
//  Схема - Соответствие, Неопределено
//  Компоненты - Соответствие, Неопределено
//  Ответ - Структура
//
Процедура ЗаполнитьЗаголовкиОтвета(Схема, Компоненты, Ответ)
	
	Если Схема = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементСхемы Из Схема Цикл
		Заголовок = ПрочитатьЗаголовокОтвета(ЭлементСхемы.Значение, Компоненты, ЭлементСхемы.Ключ);
		ДоступныеЗначения = ЗначениеСвойстваСхемы(ЭлементСхемы.Значение, Компоненты, "enum");
		ЗаполнитьДоступныеЗначения(ДоступныеЗначения, Компоненты, Заголовок);
		Ответ.Заголовки.Добавить(Заголовок);
	КонецЦикла;
	
КонецПроцедуры

// Заполняет схему контента ответа.
//
// Параметры:
//  Схема - Соответствие
//  Компоненты - Соответствие, Неопределено
//  Ответ - Структура
//
Процедура ЗаполнитьКонтентОтвета(Схема, Компоненты, Ответ)
	
	ВложеннаяСхема = ЗначениеСвойстваСхемы(Схема.Значение, Компоненты, "schema");
	Ответ.Тип = НРег(Схема.Ключ);
	Ответ.Контент = ПрочитатьКонтентОтвета(ВложеннаяСхема, Компоненты);
	
КонецПроцедуры

// Заполняет контент тела запроса.
//
// Параметры:
//  Схема - Соответствие
//  Компоненты - Соответствие, Неопределено
//  ТелоЗапроса - Структура
//  Обязательный - Булево
//
Процедура ЗаполнитьКонтентТелаЗапроса(Схема, Компоненты, ТелоЗапроса, Обязательный)
	
	ВложеннаяСхема = ЗначениеСвойстваСхемы(Схема.Значение, Компоненты, "schema");
	ТелоЗапроса.Обязательный = Обязательный;
	ТелоЗапроса.Тип = НРег(Схема.Ключ);
	ТелоЗапроса.Контент = ПрочитатьКонтентТелаЗапроса(ВложеннаяСхема, Компоненты);
	
КонецПроцедуры

// Заполняет схему ответов.
//
// Параметры:
//  Схема - Соответствие, Неопределено
//  Компоненты - Соответствие, Неопределено
//  HTTPСервис - Структура
//
Процедура ЗаполнитьОтветы(Схема, Компоненты, HTTPСервис)
	
	Если Схема = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементСхемы Из Схема Цикл
		Контенты = ЗначениеСвойстваСхемы(ЭлементСхемы.Значение, Компоненты, "content");
		Заголовки = ЗначениеСвойстваСхемы(ЭлементСхемы.Значение, Компоненты, "headers");
		
		Если Контенты = Неопределено Тогда
			// TODO - Костыль
			Если НРег(ЭлементСхемы.Ключ) = "default" Тогда
				Продолжить;
			КонецЕсли;
			
			Ответ = ПрочитатьОтвет(ЭлементСхемы.Значение, Компоненты, ЭлементСхемы.Ключ);
			ЗаполнитьЗаголовкиОтвета(Заголовки, Компоненты, Ответ);
			HTTPСервис.Ответы.Добавить(Ответ);
		Иначе
			Для Каждого Контент Из Контенты Цикл
				// TODO - Костыль
				Если НРег(ЭлементСхемы.Ключ) = "default" Тогда
					Продолжить;
				КонецЕсли;
				
				Ответ = ПрочитатьОтвет(ЭлементСхемы.Значение, Компоненты, ЭлементСхемы.Ключ);
				ЗаполнитьЗаголовкиОтвета(Заголовки, Компоненты, Ответ);
				ЗаполнитьКонтентОтвета(Контент, Компоненты, Ответ);
				HTTPСервис.Ответы.Добавить(Ответ);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Заполняет схему параметра.
//
// Параметры:
//  Схема - Соответствие
//  Компоненты - Соответствие, Неопределено
//  Параметры - Массив из Структура
//
Процедура ЗаполнитьПараметр(Схема, Компоненты, Параметры)
	
	Параметр = ПрочитатьПараметр(Схема, Компоненты);
	ДоступныеЗначения = ЗначениеСвойстваСхемы(Схема, Компоненты, "enum");
	ЗаполнитьДоступныеЗначения(ДоступныеЗначения, Компоненты, Параметр);
	Параметры.Добавить(Параметр);
	
КонецПроцедуры

// Заполняет схему параметров.
//
// Параметры:
//  Схема - Соответствие, Неопределено
//  Компоненты - Соответствие, Неопределено
//  HTTPСервис - Структура
//
Процедура ЗаполнитьПараметры(Схема, Компоненты, HTTPСервис)
	
	Если Схема = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементСхемы Из Схема Цикл
		ИсточникПараметров = ЗначениеСвойстваСхемы(ЭлементСхемы, Компоненты, "in");
		
		Если СхемыHTTPСервисовПовтИсп.ЭтоИсточникПараметровURL(ИсточникПараметров) Тогда
			ЗаполнитьПараметр(ЭлементСхемы, Компоненты, HTTPСервис.ПараметрыURL);
		ИначеЕсли СхемыHTTPСервисовПовтИсп.ЭтоИсточникПараметровЗапрос(ИсточникПараметров) Тогда
			ЗаполнитьПараметр(ЭлементСхемы, Компоненты, HTTPСервис.ПараметрыЗапроса);
		ИначеЕсли СхемыHTTPСервисовПовтИсп.ЭтоИсточникПараметровЗаголовок(ИсточникПараметров) Тогда
			ЗаполнитьПараметр(ЭлементСхемы, Компоненты, HTTPСервис.ПараметрыЗаголовков);
		ИначеЕсли СхемыHTTPСервисовПовтИсп.ЭтоИсточникПараметровКука(ИсточникПараметров) Тогда
			ЗаполнитьПараметр(ЭлементСхемы, Компоненты, HTTPСервис.ПараметрыКуки);
		КонецЕсли; // BSLLS:IfElseIfEndsWithElse-off
	КонецЦикла;
	
КонецПроцедуры

// Заполняет схему тела запроса.
//
// Параметры:
//  Схема - Соответствие, Неопределено
//  Компоненты - Соответствие, Неопределено
//  HTTPСервис - Структура
//
Процедура ЗаполнитьТелоЗапроса(Схема, Компоненты, HTTPСервис)
	
	Если Схема = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Обязательный = ЗначениеСвойстваСхемы(Схема, Компоненты, "required", Ложь);
	Контенты = ЗначениеСвойстваСхемы(Схема, Компоненты, "content");
	
	Для Каждого Контент Из Контенты Цикл
		ТелоЗапроса = ПрочитатьТелоЗапроса(Схема, Компоненты);
		ЗаполнитьКонтентТелаЗапроса(Контент, Компоненты, ТелоЗапроса, Обязательный);
		HTTPСервис.ТелоЗапроса.Добавить(ТелоЗапроса);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

