КонецФункции

// Читает описание ответа.
//
// Параметры:
//  Схема - Соответствие
//  Компоненты - Соответствие, Неопределено
//  КодСостояния - Число
//
// Возвращаемое значение:
//  Структура
//
Функция ПрочитатьОтвет(Схема, Компоненты, КодСостояния)
	
	Ответ = НовыйОтвет();
	Ответ.КодСостояния = Число(КодСостояния); // TODO - Переписать
	Возврат Ответ;
	
КонецФункции

// Читает описание параметра запроса и параметра заголовка.
//
// Параметры:
//  Схема - Соответствие
//  Компоненты - Соответствие, Неопределено
//
// Возвращаемое значение:
//  Структура
//
Функция ПрочитатьПараметр(Схема, Компоненты)
	
	Имя = ЗначениеСвойстваСхемы(Схема, Компоненты, "name");
	Обязательный = ЗначениеСвойстваСхемы(Схема, Компоненты, "required", Ложь);
	Устарел = ЗначениеСвойстваСхемы(Схема, Компоненты, "deprecated", Ложь);
	ВложеннаяСхема = ЗначениеСвойстваСхемы(Схема, Компоненты, "schema");
	
	Параметр = ПрочитатьДанныеРекурсивно(ВложеннаяСхема, Компоненты);
	Параметр.Вставить("Имя", Имя);
	Параметр.Вставить("Обязательный", Обязательный);
	Параметр.Вставить("Устарел", Устарел);
	
	Варианты = Коллекции.ЗначениеСвойстваСтруктуры(Параметр, "Варианты");
	
	Если Варианты <> Неопределено Тогда
		Для Каждого Вариант Из Варианты Цикл
			Вариант.Вставить("Обязательный", Обязательный);
			Вариант.Вставить("Устарел", Устарел);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Параметр;
	
КонецФункции

