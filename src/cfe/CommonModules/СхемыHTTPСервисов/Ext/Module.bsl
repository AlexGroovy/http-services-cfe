// Сериализует схему OpenAPI в формат 1С.
//
// Параметры:
//  Схема - Соответствие
//
// Возвращаемое значение:
//  Соответствие
//
Функция СериализоватьСхемуOpenAPI(Схема)
	
	ВерсияСтандарта = ЗначениеСвойстваСхемы(Схема, Неопределено, "openapi");
	
	Если НЕ ВерсияСтандартаПоддерживается(ВерсияСтандарта) Тогда
		ОписаниеОшибки = СтрШаблон(НСтр("ru = 'Версия стандарта OpenAPI %1 не поддерживается.'"), ВерсияСтандарта);
		ВызватьИсключение(ОписаниеОшибки);
	КонецЕсли;
	
	Схема1С = Новый Соответствие;
	Компоненты = ЗначениеСвойстваСхемы(Схема, Неопределено, "components");
	Пути = ЗначениеСвойстваСхемы(Схема, Компоненты, "paths");
	
	Для Каждого Путь Из Пути Цикл
		Для Каждого Метод Из Путь.Значение Цикл
			HTTPСервис = НовыйHTTPСервис();
			ЗаполнитьHTTPСервис(ВерсияСтандарта, Метод.Значение, Компоненты, HTTPСервис, Метод.Ключ, Путь.Ключ);
			Схема1С.Вставить(HTTPСервис.Идентификатор, HTTPСервис);
		КонецЦикла;
	КонецЦикла;
	
	Возврат Схема1С;
	
КонецФункции

#КонецОбласти
