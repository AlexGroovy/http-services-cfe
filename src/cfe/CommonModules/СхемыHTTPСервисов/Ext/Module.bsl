// Проверяет версию стандарта из схемы на предмет ее поддержки в подсистеме.
//
// Параметры:
//  ВерсияСтандарта - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ВерсияСтандартаПоддерживается(ВерсияСтандарта)
	
	Возврат СхемыHTTPСервисовПовтИсп.ЭтоВерсияСтандарта_3_0_3(ВерсияСтандарта)
		ИЛИ СхемыHTTPСервисовПовтИсп.ЭтоВерсияСтандарта_3_0_4(ВерсияСтандарта);
	
КонецФункции

// Возвращает значение свойства схемы с учетом внутренних ссылок.
//
// Параметры:
//  Схема - Соответствие
//  Компоненты - Соответствие, Неопределено
//  Свойство - Строка
//  ЗначениеПоУмолчанию - Произвольный
//
// Возвращаемое значение:
//  Произвольный
//
Функция ЗначениеСвойстваСхемы(Схема, Компоненты, Свойство, ЗначениеПоУмолчанию = Неопределено)
	
	Ссылка = Коллекции.ЗначениеСвойстваСоответствия(Схема, "$ref");
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Если НЕ ЗначениеЗаполнено(Компоненты) Тогда
			Шаблон = НСтр("ru = 'Не удалось получить значение %1. В схеме отсутствует описание блока components.'");
			ОписаниеОшибки = СтрШаблон(Шаблон, Ссылка);
			ВызватьИсключение(ОписаниеОшибки);
		КонецЕсли;
		
		ФрагментыСсылки = СтрРазделить(Ссылка, "/", Ложь);
		
		Если ФрагментыСсылки.Количество() <> 4 ИЛИ ФрагментыСсылки[0] <> "#" Тогда
			Шаблон = НСтр("ru = 'Не удалось получить значение %1. Не правильная ссылка на компонент.'");
			ОписаниеОшибки = СтрШаблон(Шаблон, Ссылка);
			ВызватьИсключение(ОписаниеОшибки);
		КонецЕсли;
		
		Значение = Коллекции.ЗначениеСвойстваСоответствия(
			Компоненты, ФрагментыСсылки[2]);
		
		Если Значение = Неопределено Тогда
			Шаблон = НСтр("ru = 'Не удалось получить значение %1. В схеме отсутствует описание блока components/%2.'");
			ОписаниеОшибки = СтрШаблон(Шаблон, Ссылка, ФрагментыСсылки[2]);
			ВызватьИсключение(ОписаниеОшибки);
		КонецЕсли;
		
		ВложенноеЗначение = Коллекции.ЗначениеСвойстваСоответствия(
			Значение, ФрагментыСсылки[3]);
		
		Если ВложенноеЗначение = Неопределено Тогда
			Шаблон = НСтр("ru = 'Не удалось получить значение %1. В схеме отсутствует описание компонента.'");
			ОписаниеОшибки = СтрШаблон(Шаблон, Ссылка);
			ВызватьИсключение(ОписаниеОшибки);
		КонецЕсли;
		
		Возврат ЗначениеСвойстваСхемы(ВложенноеЗначение, Компоненты, Свойство, ЗначениеПоУмолчанию);
	КонецЕсли;
	
	Возврат Коллекции.ЗначениеСвойстваСоответствия(
		Схема, Свойство, ЗначениеПоУмолчанию);
	
КонецФункции

