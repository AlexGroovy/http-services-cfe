// Читает варианты данные с неопределенным типом из схемы рекурсивно.
//
// Параметры:
//  Схемы - Массив из Соответствие
//  Компоненты - Соответствие, Неопределено
//  Опциональные - Булево
//
// Возвращаемое значение:
//  Структура
//
Функция ПрочитатьВариантыДанныхРекурсивно(Схемы, Компоненты, Опциональные)
	
	Данные = НовыйВарианты();
	Данные.Опциональные = Опциональные;
	
	Для Каждого Схема Из Схемы Цикл
		ВариантДанных = ПрочитатьДанныеРекурсивно(Схема, Компоненты);
		Данные.Варианты.Добавить(ВариантДанных);
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

// Читает данные с неопределенным типом из схемы.
//
// Параметры:
//  Схема - Соответствие
//  Компоненты - Соответствие, Неопределено
//
// Возвращаемое значение:
//  Структура
//
Функция ПрочитатьДанные(Схема, Компоненты)
	
	Данные = НовыйДанные();
	Данные.Тип = СхемыHTTPСервисовПовтИсп.ТипДанных(ЗначениеСвойстваСхемы(Схема, Компоненты, "type", ""));
	Данные.ДоступноNULL = ЗначениеСвойстваСхемы(Схема, Компоненты, "nullable", Ложь);
	Данные.Устарел = ЗначениеСвойстваСхемы(Схема, Компоненты, "deprecated", Ложь);
	
	ДоступныеЗначения = ЗначениеСвойстваСхемы(Схема, Компоненты, "enum");
	ЗаполнитьДоступныеЗначения(ДоступныеЗначения, Компоненты, Данные);
	
	Возврат Данные;
	
КонецФункции

// Читает данные с неопределенным типом из схемы рекурсивно.
//
// Параметры:
//  Схема - Соответствие
//  Компоненты - Соответствие, Неопределено
//
// Возвращаемое значение:
//  Структура
//
Функция ПрочитатьДанныеРекурсивно(Схема, Компоненты)
	
	Варианты = ЗначениеСвойстваСхемы(Схема, Компоненты, "oneOf");
	Опциональные = Ложь;
	
	Если Варианты = Неопределено Тогда
		Варианты = ЗначениеСвойстваСхемы(Схема, Компоненты, "anyOf");
		Опциональные = Истина;
	КонецЕсли;
	
	Если Варианты = Неопределено Тогда
		ТипДанных = ЗначениеСвойстваСхемы(Схема, Компоненты, "type", "");
		
		Если СхемыHTTPСервисовПовтИсп.ЭтоТипДанныхМассив(ТипДанных) Тогда
			Данные = ПрочитатьМассив(Схема, Компоненты);
		ИначеЕсли СхемыHTTPСервисовПовтИсп.ЭтоТипДанныхОбъект(ТипДанных) Тогда
			ОбязательныеПоля = ЗначениеСвойстваСхемы(Схема, Компоненты, "required");
			Данные = ПрочитатьОбъект(Схема, Компоненты, ОбязательныеПоля);
		ИначеЕсли СхемыHTTPСервисовПовтИсп.ЭтоТипДанныхСтрока(ТипДанных) Тогда
			Данные = ПрочитатьСтроку(Схема, Компоненты);
		ИначеЕсли СхемыHTTPСервисовПовтИсп.ЭтоТипДанныхЧисло(ТипДанных) Тогда
			Данные = ПрочитатьЧисло(Схема, Компоненты);
		ИначеЕсли СхемыHTTPСервисовПовтИсп.ЭтоТипДанныхБулево(ТипДанных) Тогда
			Данные = ПрочитатьБулево(Схема, Компоненты);
		Иначе
			Данные = ПрочитатьДанные(Схема, Компоненты);
		КонецЕсли;
	Иначе
		Данные = ПрочитатьВариантыДанныхРекурсивно(Варианты, Компоненты, Опциональные);
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

// Читает дополнительное свойство данных с типом Объект из схемы.
//
// Параметры:
//  Схема - Соответствие
//  Компоненты - Соответствие, Неопределено
//
// Возвращаемое значение:
//  Структура
//
Функция ПрочитатьДополнительноеСвойствоОбъекта(Схема, Компоненты)
	
	Возврат ПрочитатьДанныеРекурсивно(Схема, Компоненты);
	
КонецФункции

// Читает данные с типом Массив из схемы.
//
// Параметры:
//  Схема - Соответствие
//  Компоненты - Соответствие, Неопределено
//
// Возвращаемое значение:
//  Структура
//
Функция ПрочитатьМассив(Схема, Компоненты)
	
	МаксимальноеКоличество = ЗначениеСвойстваСхемы(Схема, Компоненты, "maxItems");
	МинимальноеКоличество = ЗначениеСвойстваСхемы(Схема, Компоненты, "minItems");
	Уникальные = ЗначениеСвойстваСхемы(Схема, Компоненты, "uniqueItems", Ложь);
	Элементы = ЗначениеСвойстваСхемы(Схема, Компоненты, "items");
	
	Данные = ПрочитатьДанные(Схема, Компоненты);
	Данные.Вставить("Элементы", Новый Массив);
	Данные.Вставить("МинимальноеКоличество", МинимальноеКоличество);
	Данные.Вставить("МаксимальноеКоличество", МаксимальноеКоличество);
	Данные.Вставить("Уникальные", Уникальные);
	ВложенныеДанные = ПрочитатьЭлементМассива(Элементы, Компоненты);
	Данные.Элементы.Добавить(ВложенныеДанные);
	Возврат Данные;
	
КонецФункции

// Читает данные с типом Объект из схемы.
//
// Параметры:
//  Схема - Соответствие
//  Компоненты - Соответствие, Неопределено
//  ОбязательныеПоля - Массив из Строка
//
// Возвращаемое значение:
//  Структура
//
Функция ПрочитатьОбъект(Схема, Компоненты, ОбязательныеПоля)
	
	МаксимальноеКоличество = ЗначениеСвойстваСхемы(Схема, Компоненты, "maxProperties");
	МинимальноеКоличество = ЗначениеСвойстваСхемы(Схема, Компоненты, "minProperties");
	Свойства = ЗначениеСвойстваСхемы(Схема, Компоненты, "properties", Новый Структура);
	ДополнительныеСвойства = ЗначениеСвойстваСхемы(Схема, Компоненты, "additionalProperties", Истина);
	
	Если Коллекции.ЭтоКоллекцияКлючЗначение(ДополнительныеСвойства) Тогда
		ДополнительныеСвойства = ПрочитатьДополнительноеСвойствоОбъекта(ДополнительныеСвойства, Компоненты);
	КонецЕсли;
	
	Данные = ПрочитатьДанные(Схема, Компоненты);
	Данные.Вставить("МинимальноеКоличество", МинимальноеКоличество);
	Данные.Вставить("МаксимальноеКоличество", МаксимальноеКоличество);
	Данные.Вставить("Свойства", Новый Массив);
	Данные.Вставить("ДополнительныеСвойства", ДополнительныеСвойства);
	
	Для Каждого Свойство Из Свойства Цикл
		ВложенныеДанные = ПрочитатьСвойствоОбъекта(Свойство.Значение, Компоненты, Свойство.Ключ, ОбязательныеПоля);
		Данные.Свойства.Добавить(ВложенныеДанные);
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

// Читает свойство данных с типом Объект из схемы.
//
// Параметры:
//  Схема - Соответствие
//  Компоненты - Соответствие, Неопределено
//  Имя - Строка
//  ОбязательныеПоля - Массив из Строка
//
// Возвращаемое значение:
//  Структура
//
Функция ПрочитатьСвойствоОбъекта(Схема, Компоненты, Имя, ОбязательныеПоля)
	
	Если Коллекции.ЭтоМассив(ОбязательныеПоля) Тогда
		Обязательный = ОбязательныеПоля.Найти(Имя) <> Неопределено;
	Иначе
		Обязательный = Ложь;
	КонецЕсли;
	
	Данные = ПрочитатьДанныеРекурсивно(Схема, Компоненты);
	Данные.Вставить("Имя", Имя);
	Данные.Вставить("Обязательный", Обязательный);
	
	Варианты = Коллекции.ЗначениеСвойстваСтруктуры(Данные, "Варианты");
	
	Если Варианты <> Неопределено Тогда
		Для Каждого Вариант Из Варианты Цикл
			Вариант.Вставить("Обязательный", Обязательный);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

// Читает данные с типом Строка из схемы.
//
// Параметры:
//  Схема - Соответствие
//  Компоненты - Соответствие, Неопределено
//
// Возвращаемое значение:
//  Структура
//
Функция ПрочитатьСтроку(Схема, Компоненты)
	
	ФорматДанных = СхемыHTTPСервисовПовтИсп.ФорматДанных(ЗначениеСвойстваСхемы(Схема, Компоненты, "format", ""));
	Паттерн = ЗначениеСвойстваСхемы(Схема, Компоненты, "pattern");
	МинимальнаяДлинна = ЗначениеСвойстваСхемы(Схема, Компоненты, "minLength");
	МаксимальнаяДлинна = ЗначениеСвойстваСхемы(Схема, Компоненты, "maxLength");
	
	Данные = ПрочитатьДанные(Схема, Компоненты);
	Данные.Вставить("Формат", ФорматДанных);
	Данные.Вставить("Паттерн", Паттерн);
	Данные.Вставить("МинимальнаяДлинна", МинимальнаяДлинна);
	Данные.Вставить("МаксимальнаяДлинна", МаксимальнаяДлинна);
	Возврат Данные;
	
КонецФункции

// Читает данные с типом Число из схемы.
//
// Параметры:
//  Схема - Соответствие
//  Компоненты - Соответствие, Неопределено
//
// Возвращаемое значение:
//  Структура
//
Функция ПрочитатьЧисло(Схема, Компоненты)
	
	ФорматДанных = СхемыHTTPСервисовПовтИсп.ФорматДанных(ЗначениеСвойстваСхемы(Схема, Компоненты, "format", ""));
	МинимальноеЗначение = ЗначениеСвойстваСхемы(Схема, Компоненты, "minimum");
	МаксимальноеЗначение = ЗначениеСвойстваСхемы(Схема, Компоненты, "maximum");
	ЗначениеКратно = ЗначениеСвойстваСхемы(Схема, Компоненты, "multipleOf");
	ИсключитьМинимальноеЗначение = ЗначениеСвойстваСхемы(Схема, Компоненты, "exclusiveMinimum", Ложь);
	ИсключитьМаксимальноеЗначение = ЗначениеСвойстваСхемы(Схема, Компоненты, "exclusiveMaximum", Ложь);
	
	Данные = ПрочитатьДанные(Схема, Компоненты);
	Данные.Вставить("Формат", ФорматДанных);
	Данные.Вставить("МинимальноеЗначение", МинимальноеЗначение);
	Данные.Вставить("МаксимальноеЗначение", МаксимальноеЗначение);
	Данные.Вставить("ИсключитьМинимальноеЗначение", ИсключитьМинимальноеЗначение);
	Данные.Вставить("ИсключитьМаксимальноеЗначение", ИсключитьМаксимальноеЗначение);
	Данные.Вставить("ЗначениеКратно", ЗначениеКратно);
	Возврат Данные;
	
КонецФункции

